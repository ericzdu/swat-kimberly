# AI-SWAT+ — copy to `.env` and fill in what you need. Everything here is OPTIONAL:
# the Docker image bakes in the SWAT+ engine, the rev-62 template and the demo
# project, so `docker compose up --build` works with no .env at all.

# ---- LLM provider (optional — you can also set this in the app's Settings page) ----
# Pick ONE provider and set its key.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# Ollama running on the host (use host.docker.internal from inside the container):
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- Engine / asset overrides (Docker sets these already; only for local dev) ----
# Windows local run (engine is a Windows .exe):
# SWATPLUS_EXE=G:/AI-SWAT+ project/swatplus_bin/swatplus-62.0.0-gnu-win_amd64-Rel.exe
# REV62_TEMPLATE=G:/AI-SWAT+ project/rev62_template/TxtInOut
# DEMO_TXTINOUT=G:/AI-SWAT+ project/a10_single_hru/a10_single_hru/Scenarios/Default/TxtInOut
# DATA_ROOT=G:/AI-SWAT+ project/data
