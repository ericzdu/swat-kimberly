{
  "name": "ai-swat",
  "version": "0.1.0",
  "description": "AI-powered SWAT+ decision support for growers and farmers",
  "private": true,
  "main": "electron/main.js",
  "author": "AI-SWAT+ Team",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:web": "concurrently \"npm run dev:api\" \"npm run dev:frontend\"",
    "dev:api": "cd backend && python run_server.py",
    "dev:frontend": "cd src && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm run build:frontend && npm run build:electron",
    "build:frontend": "cd src && npm run build",
    "build:electron": "electron-builder"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.aiswat.farmadvisor",
    "productName": "AI-SWAT+ Farm Advisor",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "build/**/*",
      "backend/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}